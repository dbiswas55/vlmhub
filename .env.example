# Copy to .env and fill in the values you need. Only the hostings you
# actually use require a value here — see models.json for which env
# var each hosting expects.

# gemini hosting (Google AI Studio)
GEMINI_API_KEY=

# openai hosting
OPENAI_API_KEY=

# anthropic hosting
ANTHROPIC_API_KEY=

# openrouter hosting
OPENROUTER_API_KEY=

# vertex_ai hosting (also needs Application Default Credentials)
GCP_PROJECT=
GCP_LOCATION=

# transformers hosting, and any local model download
HF_TOKEN=
HF_HOME=.cache/huggingface
