{
  "_comment": "Bundled model registry. 'active' picks the default client; reference any client in code as 'hosting/model'. Field precedence: model > hosting > defaults.",

  "active": {
    "hosting": "ollama",
    "model": "gemma3-4b"
  },

  "defaults": {
    "max_new_tokens": 4096,
    "temperature": 0.3,
    "top_p": null,
    "top_k": null,
    "reasoning_effort": null
  },

  "hostings": {

    "_comment_api": "── Cloud APIs ────────────────────────────────────────────────",
    "_comment_api_tokens": "Cloud hostings raise max_new_tokens to 16000 (reasoning models count thinking tokens against it). A model with sampling=false rejects temperature/top_p/top_k, so they are dropped.",

    "gemini": {
      "_comment": "Google AI Studio, via LiteLLM's native 'gemini/' provider. 2.5 models take thinking_budget; 3.x models take reasoning_effort (mapped to thinking_level).",
      "backend": "litellm",
      "litellm_prefix": "gemini",
      "api_key_env": "GEMINI_API_KEY",
      "max_new_tokens": 16000,
      "models": [
        { "name": "flash-2.5",      "model_id": "gemini-2.5-flash", "thinking_budget": 0 },
        { "name": "flash-3.5",      "model_id": "gemini-3.5-flash" },
        { "name": "flash-3.5lite",  "model_id": "gemini-3.5-flash-lite" },
        { "name": "flash-3.6",      "model_id": "gemini-3.6-flash" },
        { "name": "flash-3.8",      "model_id": "gemini-3.8-flash" },
        { "name": "pro-2.5",        "model_id": "gemini-2.5-pro" },
        { "name": "pro-3.1preview", "model_id": "gemini-3.1-pro-preview" },
        { "name": "gemma4-26b-a4b", "model_id": "gemma-4-26b-a4b-it" }
      ]
    },

    "vertex_ai": {
      "_comment": "Same Gemini models via Vertex AI (Application Default Credentials).",
      "backend": "litellm",
      "litellm_prefix": "vertex_ai",
      "vertex_project_env": "GCP_PROJECT",
      "vertex_location_env": "GCP_LOCATION",
      "max_new_tokens": 16000,
      "models": [
        { "name": "flash-2.5",      "model_id": "gemini-2.5-flash", "thinking_budget": 0 },
        { "name": "flash-3.5",      "model_id": "gemini-3.5-flash" },
        { "name": "flash-3.5lite",  "model_id": "gemini-3.5-flash-lite" },
        { "name": "flash-3.6",      "model_id": "gemini-3.6-flash" },
        { "name": "flash-3.8",      "model_id": "gemini-3.8-flash" },
        { "name": "pro-2.5",        "model_id": "gemini-2.5-pro" },
        { "name": "pro-3.1preview", "model_id": "gemini-3.1-pro-preview" }
      ]
    },

    "openai": {
      "_comment": "OpenAI's own API.",
      "backend": "litellm",
      "litellm_prefix": "openai",
      "api_key_env": "OPENAI_API_KEY",
      "max_new_tokens": 16000,
      "models": [
        { "name": "gpt-4o",      "model_id": "gpt-4o-2024-08-06" },
        { "name": "gpt-4o-mini", "model_id": "gpt-4o-mini-2024-07-18" },
        { "name": "gpt-4.1",     "model_id": "gpt-4.1-2025-04-14" },
        { "name": "gpt-5.4",     "model_id": "gpt-5.4-2026-03-05" },
        { "name": "gpt-5.6-sol", "model_id": "gpt-5.6-sol", "sampling": false }
      ]
    },

    "anthropic": {
      "_comment": "Anthropic's own API, via LiteLLM's native 'anthropic/' provider.",
      "backend": "litellm",
      "litellm_prefix": "anthropic",
      "api_key_env": "ANTHROPIC_API_KEY",
      "max_new_tokens": 16000,
      "models": [
        { "name": "haiku-4.5",  "model_id": "claude-haiku-4-5-20251001" },
        { "name": "sonnet-4.6", "model_id": "claude-sonnet-4-6" },
        { "name": "sonnet-5",   "model_id": "claude-sonnet-5", "sampling": false },
        { "name": "opus-4.8",   "model_id": "claude-opus-4-8", "sampling": false },
        { "name": "opus-5",     "model_id": "claude-opus-5", "sampling": false },
        { "name": "opus-5.5",   "model_id": "claude-opus-5-5", "sampling": false }
      ]
    },

    "openrouter": {
      "_comment": "OpenAI, Claude and Gemini through one OpenRouter key. IDs are OpenRouter's own.",
      "backend": "litellm",
      "litellm_prefix": "openrouter",
      "api_key_env": "OPENROUTER_API_KEY",
      "max_new_tokens": 16000,
      "models": [
        { "name": "flash-3.5lite",   "model_id": "google/gemini-3.5-flash-lite" },
        { "name": "flash-3.8",       "model_id": "google/gemini-3.8-flash" },
        { "name": "pro-2.5",         "model_id": "google/gemini-2.5-pro" },
        { "name": "gpt-4o-mini",     "model_id": "openai/gpt-4o-mini-2024-07-18" },
        { "name": "gpt-4o",          "model_id": "openai/gpt-4o-2024-08-06" },
        { "name": "gpt-4.1",         "model_id": "openai/gpt-4.1" },
        { "name": "gpt-5.4",         "model_id": "openai/gpt-5.4" },
        { "name": "haiku-4.5",       "model_id": "anthropic/claude-haiku-4.5" },
        { "name": "sonnet-4.6",      "model_id": "anthropic/claude-sonnet-4.6" },
        { "name": "sonnet-5",        "model_id": "anthropic/claude-sonnet-5", "sampling": false }
      ]
    },

    "_comment_local": "── Local servers ─────────────────────────────────────────────",

    "ollama": {
      "_comment": "OpenAI-compatible local server; no api_key needed.",
      "backend": "litellm",
      "litellm_prefix": "openai",
      "api_base": "http://localhost:11434/v1",
      "models": [
        { "name": "gemma3-4b",   "model_id": "gemma3:4b" },
        { "name": "gemma3-12b",  "model_id": "gemma3:12b" },
        { "name": "qwen3vl-4b",  "model_id": "qwen3-vl:4b" },
        { "name": "qwen3vl-8b",  "model_id": "qwen3-vl:8b" }
      ]
    },

    "mlx_vlm": {
      "_comment": "macOS / Apple Silicon. Uses the same HuggingFace model IDs the server was started with.",
      "backend": "litellm",
      "litellm_prefix": "openai",
      "api_base": "http://localhost:8080/v1",
      "models": [
        { "name": "gemma3-4b",   "model_id": "mlx-community/gemma-3-4b-it-4bit" },
        { "name": "gemma3-12b",  "model_id": "mlx-community/gemma-3-12b-it-qat-4bit" },
        { "name": "qwen3vl-4b",  "model_id": "mlx-community/Qwen3-VL-4B-Instruct-4bit" },
        { "name": "qwen3vl-8b",  "model_id": "mlx-community/Qwen3-VL-8B-Instruct-8bit" }
      ]
    },

    "vllm": {
      "_comment": "Uses same HuggingFace model IDs as transformers.",
      "backend": "litellm",
      "litellm_prefix": "hosted_vllm",
      "api_base": "http://127.0.0.1:8000/v1",
      "models": [
        { "name": "gemma3-4b",   "model_id": "google/gemma-3-4b-it" },
        { "name": "gemma3-12b",  "model_id": "google/gemma-3-12b-it" },
        { "name": "qwen3vl-4b",  "model_id": "Qwen/Qwen3-VL-4B-Instruct" },
        { "name": "qwen3vl-8b",  "model_id": "Qwen/Qwen3-VL-8B-Instruct" }
      ]
    },

    "_comment_inproc": "── In-process (no server) ───────────────────────────────────────",

    "transformers": {
      "_comment_quantization": "quantization_level: null (full precision) or '4bit' (NF4, CUDA only — ignored elsewhere).",
      "_comment_dtype": "fallback_dtype: dtype for GPUs without native bfloat16 (sm < 80); null keeps bfloat16, emulated there (slow).",
      "_comment_processor": "processor_kwargs: extra args passed to AutoProcessor.from_pretrained, only where needed. Idefics3: do_image_splitting=false skips upscaling/tiling each frame (~3000 -> ~175 tokens/frame).",
      "backend": "transformers",
      "quantization_level": null,
      "models": [
        { "name": "gemma3-4b",     "model_id": "google/gemma-3-4b-it",                       "model_class": "AutoModelForImageTextToText", "fallback_dtype": null, "notes": ["no safe fp16 fallback: fp16 overflows into NaN logits; runs emulated bf16 on V100"] },
        { "name": "gemma3-12b",    "model_id": "google/gemma-3-12b-it",                      "model_class": "AutoModelForImageTextToText", "fallback_dtype": null, "notes": ["no safe fp16 fallback: fp16 overflows into NaN logits; runs emulated bf16 on V100", "~24GB in bf16 does not fit a 16GB V100 -- that card needs quantization_level '4bit'"] },
        { "name": "qwen3vl-4b",    "model_id": "Qwen/Qwen3-VL-4B-Instruct",                  "model_class": "AutoModelForImageTextToText", "fallback_dtype": "float16" },
        { "name": "qwen3vl-8b",    "model_id": "Qwen/Qwen3-VL-8B-Instruct",                  "model_class": "AutoModelForImageTextToText", "fallback_dtype": "float16" },
        { "name": "qwen25vl-7b",   "model_id": "Qwen/Qwen2.5-VL-7B-Instruct",                "model_class": "AutoModelForImageTextToText", "fallback_dtype": "float16" },
        { "name": "internvl35-8b", "model_id": "OpenGVLab/InternVL3_5-8B-HF",                "model_class": "AutoModelForImageTextToText", "fallback_dtype": "float16" },
        { "name": "mplugowl3-7b",  "model_id": "mPLUG/mPLUG-Owl3-7B-241101",                 "model_class": "AutoModelForCausalLM",        "fallback_dtype": "float16" },
        { "name": "molmo2-7b",     "model_id": "allenai/Molmo2-O-7B",                        "model_class": "AutoModelForImageTextToText", "fallback_dtype": null, "notes": ["fp16 safety unverified; runs emulated bf16 on V100 until tested, then set fallback_dtype"] },
        { "name": "idefics3-8b",   "model_id": "HuggingFaceM4/Idefics3-8B-Llama3",           "model_class": "AutoModelForImageTextToText", "fallback_dtype": "float16", "processor_kwargs": { "do_image_splitting": false } },
        { "name": "llavaov-7b",    "model_id": "llava-hf/llava-onevision-qwen2-7b-ov-hf",    "model_class": "AutoModelForImageTextToText", "fallback_dtype": "float16" }
      ]
    }

  }
}
