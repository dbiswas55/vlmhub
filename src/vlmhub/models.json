{
  "_comment": "The bundled model registry. Active client is selected by 'active.hosting' + 'active.model'; reference one in code as 'hosting/model'. Model-level fields override hosting-level fields, which override 'defaults'.",

  "active": {
    "hosting": "ollama",
    "model": "gemma3-4b"
  },

  "defaults": {
    "max_tokens": 4096,
    "temperature": 0.3,
    "top_p": 1.0
  },

  "hostings": {

    "_comment_api": "── Cloud API providers (all routed through LiteLLM) ────────────",

    "gemini": {
      "_comment": "Gemini via Google AI Studio (API key), LiteLLM's native 'gemini/' provider — full feature access including thinking_budget.",
      "backend": "litellm",
      "litellm_prefix": "gemini",
      "api_key_env": "GEMINI_API_KEY",
      "models": [
        { "name": "flash-2.5",      "model_id": "gemini-2.5-flash", "thinking_budget": 0 },
        { "name": "flash-3.1lite",  "model_id": "gemini-3.1-flash-lite", "thinking_budget": 0 },
        { "name": "flash-3.5lite",  "model_id": "gemini-3.5-flash-lite", "thinking_budget": 0 },
        { "name": "flash-3.6",      "model_id": "gemini-3.6-flash", "thinking_budget": 0 },
        { "name": "pro-2.5",        "model_id": "gemini-2.5-pro", "thinking_budget": -1, "max_tokens": null },
        { "name": "pro-3.1preview", "model_id": "gemini-3.1-pro-preview", "thinking_budget": -1, "max_tokens": null }
      ]
    },

    "gemini_vtx": {
      "_comment": "Same models routed through Vertex AI (uses Application Default Credentials).",
      "backend": "litellm",
      "litellm_prefix": "vertex_ai",
      "vertex_project_env": "GCP_PROJECT",
      "vertex_location_env": "GCP_LOCATION",
      "models": [
        { "name": "flash-2.5",      "model_id": "gemini-2.5-flash", "thinking_budget": 0 },
        { "name": "flash-3.1lite",  "model_id": "gemini-3.1-flash-lite", "thinking_budget": 0 },
        { "name": "flash-3.5lite",  "model_id": "gemini-3.5-flash-lite", "thinking_budget": 0 },
        { "name": "flash-3.6",      "model_id": "gemini-3.6-flash", "thinking_budget": 0 },
        { "name": "pro-2.5",        "model_id": "gemini-2.5-pro", "thinking_budget": -1, "max_tokens": null },
        { "name": "pro-3.1preview", "model_id": "gemini-3.1-pro-preview", "thinking_budget": -1, "max_tokens": null }
      ]
    },

    "openai": {
      "backend": "litellm",
      "litellm_prefix": "openai",
      "api_key_env": "OPENAI_API_KEY",
      "models": [
        { "name": "gpt-4o",      "model_id": "gpt-4o" },
        { "name": "gpt-4o-mini", "model_id": "gpt-4o-mini" }
      ]
    },

    "_comment_local": "── Local inference servers ─────────────────────────────────────",

    "ollama": {
      "_comment": "Reached as an OpenAI-compatible server; api_key is a placeholder Ollama ignores.",
      "backend": "litellm",
      "litellm_prefix": "openai",
      "api_base": "http://localhost:11434/v1",
      "api_key": "ollama",
      "models": [
        { "name": "gemma3-4b",   "model_id": "gemma3:4b" },
        { "name": "gemma3-12b",  "model_id": "gemma3:12b" },
        { "name": "qwen3vl-4b",  "model_id": "qwen3-vl:4b" },
        { "name": "qwen3vl-8b",  "model_id": "qwen3-vl:8b" }
      ]
    },

    "mlx_vlm": {
      "_comment": "macOS / Apple Silicon. Uses the same HuggingFace model IDs the server was started with.",
      "backend": "litellm",
      "litellm_prefix": "openai",
      "api_base": "http://localhost:8080/v1",
      "api_key": "mlx",
      "models": [
        { "name": "gemma3-4b",   "model_id": "mlx-community/gemma-3-4b-it-4bit" },
        { "name": "gemma3-12b",  "model_id": "mlx-community/gemma-3-12b-it-qat-4bit" },
        { "name": "qwen3vl-4b",  "model_id": "mlx-community/Qwen3-VL-4B-Instruct-4bit" },
        { "name": "qwen3vl-8b",  "model_id": "mlx-community/Qwen3-VL-8B-Instruct-8bit" }
      ]
    },

    "vllm": {
      "_comment": "Uses same HuggingFace model IDs as transformers.",
      "backend": "litellm",
      "litellm_prefix": "hosted_vllm",
      "api_base": "http://127.0.0.1:8000/v1",
      "models": [
        { "name": "gemma3-4b",   "model_id": "google/gemma-3-4b-it" },
        { "name": "gemma3-12b",  "model_id": "google/gemma-3-12b-it" },
        { "name": "qwen3vl-4b",  "model_id": "Qwen/Qwen3-VL-4B-Instruct" },
        { "name": "qwen3vl-8b",  "model_id": "Qwen/Qwen3-VL-8B-Instruct" }
      ]
    },

    "_comment_inproc": "── In-process inference (no server required) ───────────────────",

    "transformers": {
      "_comment": "quantization_level: null | '4bit' (NF4). Set '4bit' to quantize, which applies on CUDA only (ignored with a warning on MPS/CPU) and also lets a model spill across cards.",
      "_dtype_comment": "All models here are native bfloat16. fallback_dtype is used on GPUs without native bfloat16 tensor cores (sm < 80); if fallback_dtype is null, bfloat16 is kept and runs emulated there.",
      "_class_comment": "model_class: the transformers auto-class to load with. Omitted means AutoModelForImageTextToText — list it only for a model registered under a different class.",
      "_processor_comment": "processor_kwargs: extra arguments passed as-is to AutoProcessor.from_pretrained — list them only for a model that needs one. Idefics3: do_image_splitting=false stops each frame being upscaled to 1456px and cut into 17 tiles (~3000 -> ~175 tokens/frame).",
      "backend": "transformers",
      "quantization_level": null,
      "models": [
        { "name": "gemma3-4b",     "model_id": "google/gemma-3-4b-it",                       "fallback_dtype": null, "notes": ["no safe fp16 fallback: fp16 overflows into NaN logits; runs emulated bf16 on V100"] },
        { "name": "gemma3-12b",    "model_id": "google/gemma-3-12b-it",                      "fallback_dtype": null, "notes": ["no safe fp16 fallback: fp16 overflows into NaN logits; runs emulated bf16 on V100", "~24GB in bf16 does not fit a 16GB V100 -- that card needs quantization_level '4bit'"] },
        { "name": "qwen3vl-4b",    "model_id": "Qwen/Qwen3-VL-4B-Instruct",                  "fallback_dtype": "float16" },
        { "name": "qwen3vl-8b",    "model_id": "Qwen/Qwen3-VL-8B-Instruct",                  "fallback_dtype": "float16" },
        { "name": "qwen25vl-7b",   "model_id": "Qwen/Qwen2.5-VL-7B-Instruct",                "fallback_dtype": "float16" },
        { "name": "internvl35-8b", "model_id": "OpenGVLab/InternVL3_5-8B-HF",                "fallback_dtype": "float16" },
        { "name": "mplugowl3-7b",  "model_id": "mPLUG/mPLUG-Owl3-7B-241101",                 "fallback_dtype": "float16", "model_class": "AutoModelForCausalLM" },
        { "name": "molmo2-7b",     "model_id": "allenai/Molmo2-O-7B",                        "fallback_dtype": null, "notes": ["fp16 safety unverified; runs emulated bf16 on V100 until tested, then set fallback_dtype"] },
        { "name": "idefics3-8b",   "model_id": "HuggingFaceM4/Idefics3-8B-Llama3",           "fallback_dtype": "float16", "processor_kwargs": { "do_image_splitting": false } },
        { "name": "llavaov-7b",    "model_id": "llava-hf/llava-onevision-qwen2-7b-ov-hf",    "fallback_dtype": "float16" }
      ]
    }

  }
}
